#!/bin/sh
# Development Pi operations. Install root-owned at /usr/local/sbin/livolodctl.
# Run with sudo; the deployment directory contains private MQTT credentials.
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo 'Run this command with sudo.' >&2
    exit 1
fi

action=${1:-status}
if [ "$#" -gt 0 ]; then shift; fi

# Run Compose against the fixed development deployment from any directory.
# Arguments are forwarded as Compose subcommands and options.
compose() {
    /usr/bin/docker compose --project-name livolod \
        --project-directory /opt/livolod-docker \
        --file /opt/livolod-docker/compose.yaml "$@"
}

case "$action" in
    stop)
        compose stop --timeout 30 livolod
        ;;
    start)
        # Recreate to resolve the USB by-id path again after a flash/replug.
        compose up --detach --force-recreate --pull never livolod
        ;;
    restart)
        compose stop --timeout 30 livolod
        compose up --detach --force-recreate --pull never livolod
        ;;
    status)
        compose ps --all
        ;;
    logs)
        compose logs --tail 100 "$@" livolod
        ;;
    *)
        echo 'Usage: sudo livolodctl {stop|start|restart|status|logs [-f]}' >&2
        exit 2
        ;;
esac
